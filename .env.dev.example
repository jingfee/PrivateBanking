# Local development. Copy to .env.dev (ignored by git).
# Use a separate Enable Banking *sandbox* application here, never the production key.
EB_APP_ID=
EB_KEY_PATH=secrets/eb-sandbox.pem
# Register this as a redirect URL on the sandbox application
EB_REDIRECT_URL=http://localhost:5173/callback
# Set to true only if you want scheduled syncs locally
SCHEDULER_ENABLED=false
