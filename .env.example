# Enable Banking application id (the .pem file name, without .pem)
EB_APP_ID=
# Must be one of the redirect URLs registered on the Enable Banking application
EB_REDIRECT_URL=https://bank.example.com/callback
# How often to fetch new transactions
SYNC_INTERVAL_HOURS=6
# Where the container listens on the host (the reverse proxy forwards to this)
PB_LISTEN=127.0.0.1:8000
# Image tag to run, e.g. sha-abc1234 to roll back
PB_TAG=latest
# Image to run (defaults to this repository's image on ghcr.io)
# PB_IMAGE=ghcr.io/<owner>/privatebanking
# Where the database lives on the host (absolute path recommended)
# PB_DATA_DIR=/srv/privatebanking/data
# The Enable Banking private key on the host
# PB_KEY_FILE=/srv/privatebanking/eb.pem
